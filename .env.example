# Salin menjadi .env — JANGAN di-commit. Semua rahasia hanya ada di server.

# ── Wajib ───────────────────────────────────────────────────────────────
# String acak panjang (min. 32 karakter). Membuat ID item tersamar & sesi login aman.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=
ADMIN_USERNAME=admin
# Hasil dari: npm run admin:hash
ADMIN_PASSWORD_HASH=

# ── Penyimpanan ─────────────────────────────────────────────────────────
# drive = Google Drive (produksi) · local = disk server (uji coba)
STORAGE_BACKEND=drive
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dapatkan dengan: npm run drive:token
GOOGLE_REFRESH_TOKEN=
# ID folder Drive yang menjadi akar arsip (ada di URL folder). Tidak pernah dikirim ke browser.
DRIVE_ROOT_FOLDER_ID=
# Hanya untuk STORAGE_BACKEND=local
# LOCAL_STORAGE_DIR=./data/storage

# ── Opsional ────────────────────────────────────────────────────────────
# Alamat halaman admin (ganti ke sesuatu yang tidak mudah ditebak). Dev (Vite): /admin.html
ADMIN_PATH=/admin
PORT=8787
MAX_UPLOAD_MB=200
SESSION_HOURS=8
SESSION_IDLE_MINUTES=120
# Di belakang reverse proxy/hosting HTTPS isi 1 (jumlah proxy) agar IP & cookie Secure benar.
# TRUST_PROXY=1
# Jika proxy mengubah header Host, daftarkan origin publik: https://arsip.contoh.com
# ALLOWED_ORIGINS=

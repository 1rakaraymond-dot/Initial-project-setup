{
  "name": "blood-moon-drive-folder-explorer",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "A Bloodborne-inspired folder explorer with CSS 3D folders, a Node API in front of Google Drive, and a private admin panel.",
  "scripts": {
    "dev": "vite",
    "dev:all": "node server/tools/dev-all.js",
    "server": "node server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "preview": "vite preview",
    "test": "node --test tests/local.test.mjs tests/drive.test.mjs",
    "admin:hash": "node server/tools/hash-password.js",
    "drive:token": "node server/tools/get-refresh-token.js"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "postcss-import": "^16.1.0",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0"
  },
  "engines": {
    "node": ">=20"
  }
}
